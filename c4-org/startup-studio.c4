      icon https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/icons/unlock.svg
      technology 'skill: —'
      description 'out: قالب ثابت: ارزش، فرم ثبت‌نام، دمو؛ فقط متن و تصویر عوض می‌شود'
      metadata {
        part 'fixed'
        agent 'ایجنت سایت'
      }
    }
    c3 = autoStep 'آنالیتیکس و سئوی پایه' {
      #unknownSkill
      icon https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/icons/unlock.svg
      technology 'skill: —'
      description 'out: چک‌لیست ثابت: ردیابی ثبت‌نام، یک کلیدواژهٔ اصلی، عنوان و توضیح، سرعت و موبایل، نقشهٔ سایت'
      metadata {
        part 'fixed'
        agent 'ایجنت سایت'
      }
    }
    c4 = gateStep 'صفحهٔ قیمت و سیاست بازگشت وجه' {
      icon https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/icons/unlock.svg
      technology 'skill: pricing-advisor'
      description 'out: ۲ تا ۳ پلن از نتیجهٔ قیمت‌گذاری؛ تأیید انسان'
      metadata {
        part 'dynamic'
        agent 'ایجنت سایت'
      }
    }
    c5 = gateStep 'اعتماد: قوانین، حریم خصوصی و اینماد' {
      #unknownSkill
      icon https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/icons/unlock.svg
      technology 'skill: —'
      description 'out: متن‌ها از بخش حقوقی؛ نماد اعتماد نیاز به هویت، پرداخت و تعهدنامه دارد و فقط با انسان؛ شرایط و هزینه تاریخ‌دار و باید دوباره تأیید شود'
      metadata {
        part 'fixed'
        agent 'ایجنت سایت'
      }
    }
    c6 = gateStep 'تأیید و انتشار سایت' {
      #unknownSkill
      icon https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/icons/unlock.svg
      technology 'skill: —'
      description 'out: انتشار بیرونی فقط با انسان'
      metadata {
        part 'fixed'
        agent 'ایجنت سایت'
      }
    }
    c1 -> c2 'بعد'
    c2 -> c3 'بعد'
    c3 -> c4 'بعد'
    c4 -> c5 'بعد'
    c5 -> c6 'بعد'
  }

  ads = orgBox 'تبلیغات' {
    icon https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/icons/unlock.svg
    description 'out: انتخاب کانال، آزمون بودجهٔ کم، اندازه‌گیری و بهینه‌سازی'
    metadata {
      agent 'ایجنت تبلیغات'
      must 'هر هزینه، تغییر بودجه و ادعای تبلیغ فقط با تأیید انسان؛ قوانین هر پلتفرم بررسی شود'
      must_not 'ادعای تضمین نتیجه یا بازده؛ رأی و نظر جعلی؛ ارسال انبوه ناخواسته'
    }
    c1 = askStep 'انتخاب کانال‌ها' {
      #unknownSkill
      icon https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/icons/unlock.svg
      technology 'skill: —'
      description 'out: کانال‌های مناسب مخاطب (جستجو، شبکه‌های اجتماعی، پیام‌رسان‌های ایرانی، تبلیغات بومی)؛ سهم و قیمت هر کانال ایران UNKNOWN تا بررسی'
      metadata {
        part 'dynamic'
        agent 'ایجنت تبلیغات'
      }
    }
    c2 = gateStep 'تعیین بودجه و سقف آزمون' {
      #unknownSkill
      icon https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/icons/unlock.svg
      technology 'skill: —'
      description 'out: بودجهٔ کم برای هر کانال و سقف روزانه؛ تأیید پول با انسان'
      metadata {
        part 'dynamic'
        agent 'ایجنت تبلیغات'
      }
    }
    c3 = autoStep 'ردیابی و اتریبیوشن' {
      #unknownSkill
      icon https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/icons/unlock.svg
      technology 'skill: —'
      description 'out: لینک‌های ردیابی (UTM)، هدف تبدیل و جدول هزینهٔ جذب مشتری'
      metadata {
        part 'fixed'
        agent 'ایجنت تبلیغات'
      }
    }
    c4 = autoStep 'ساخت پیش‌نویس کمپین و متن‌ها' {
      #unknownSkill
      icon https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/icons/unlock.svg
      technology 'skill: —'
      description 'out: چند نسخهٔ متن و تصویر برای آزمون A/B؛ بررسی با قوانین پلتفرم'
      metadata {
        part 'dynamic'
        agent 'ایجنت تبلیغات'
      }
    }
    c5 = gateStep 'تأیید و راه‌اندازی کمپین' {
      #unknownSkill
      icon https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/icons/unlock.svg
      technology 'skill: —'
      description 'out: هزینه و انتشار فقط با انسان'
      metadata {
        part 'fixed'
        agent 'ایجنت تبلیغات'
      }
    }
    c6 = autoStep 'گزارش و بهینه‌سازی هفتگی' {
      #unknownSkill
      icon https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/icons/unlock.svg
      technology 'skill: —'
      description 'out: گزارش هزینه، تبدیل و هزینهٔ جذب؛ پیشنهاد قطع یا افزایش بودجه با تأیید انسان'
      metadata {
        part 'fixed'
        agent 'ایجنت تبلیغات'
      }
    }
    c1 -> c2 'بعد'
    c2 -> c3 'بعد'
    c3 -> c4 'بعد'
    c4 -> c5 'بعد'
    c5 -> c6 'بعد'
  }

  content = orgBox 'محتوا و انتشار' {
    icon https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/icons/unlock.svg
    description 'out: استراتژی، ساخت، تأیید، زمان‌بندی و بازتولید'
    metadata {
      schedule 'weekly'
      agent 'ایجنت محتوا'
      must 'هر نقل‌قول و ادعا راستی‌آزمایی شود؛ انتشار بیرونی فقط با تأیید انسان'
      must_not 'محتوای جعلی یا نظر ساختگی؛ ادعای بی‌منبع؛ هرزنامه'
    }
    c1 = askStep 'لحن برند و ستون‌های محتوا' {
      #unknownSkill
      icon https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/icons/unlock.svg
      technology 'skill: —'
      description 'out: لحن، موضوع‌های اصلی و مخاطب هر کانال'
      metadata {
        part 'dynamic'
        agent 'ایجنت محتوا'
      }
    }
    c2 = autoStep 'تقویم محتوا' {
      #unknownSkill
      icon https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/icons/unlock.svg
      technology 'skill: —'
      description 'out: تقویم هفتگی و ماهانه با قالب ثابت'
      metadata {
        part 'fixed'
        agent 'ایجنت محتوا'
      }
    }
    c3 = autoStep 'ساخت محتوا: نوشته، تصویر و ویدئو کوتاه' {
      #unknownSkill
      icon https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/icons/unlock.svg
      technology 'skill: —'
      description 'out: پیش‌نویس هر قطعه با منبع ادعاها'
      metadata {
        part 'dynamic'
        agent 'ایجنت محتوا'
      }
    }
    c4 = autoStep 'بازتولید برای کانال‌های دیگر' {
      #unknownSkill
      icon https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/icons/unlock.svg
      technology 'skill: —'
      description 'out: یک محتوای اصلی به چند قالب (کوتاه، اسلاید، خبرنامه)'
      metadata {
        part 'fixed'
        agent 'ایجنت محتوا'
      }
    }
    c5 = gateStep 'بازبینی و تأیید' {
      #unknownSkill
      icon https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/icons/unlock.svg
      technology 'skill: —'
      description 'out: انسان وضعیت «تأییدشده» را می‌دهد'
      metadata {
        part 'fixed'
        agent 'ایجنت محتوا'
      }
    }
    c6 = autoStep 'زمان‌بندی و انتشار' {
      #unknownSkill
      icon https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/icons/unlock.svg
      technology 'skill: —'
      description 'out: انتشار فقط پس از تأیید؛ قوانین هر پلتفرم UNKNOWN برای ایران تا بررسی'
      metadata {
        part 'fixed'
        agent 'ایجنت محتوا'
      }
    }
    c7 = autoStep 'پایش و یادگیری' {
      #unknownSkill
      icon https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/icons/unlock.svg
      technology 'skill: —'
      description 'out: کدام محتوا مشتری آورد؛ ورودی تقویم بعد'
      metadata {
        part 'fixed'
        agent 'ایجنت محتوا'
      }
    }
    c1 -> c2 'بعد'
    c2 -> c3 'بعد'
    c3 -> c4 'بعد'
    c4 -> c5 'بعد'
    c5 -> c6 'بعد'
    c6 -> c7 'بعد'
  }

  p7 = orgBox 'تجاری‌سازی و فروش' {
    icon https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/icons/unlock.svg
    description 'out: از قیمت تا مشتری اول'
    metadata {
      agent 'ایجنت تجاری‌سازی'
    }
    c1 = autoStep 'انتخاب مدل درآمد و قیمت' {
      icon https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/icons/unlock.svg
      technology 'skill: pricing-advisor'
      description 'out: مدل درآمد + جدول قیمت + نردبان جذب مشتری'
      metadata {
        agent 'ایجنت تجاری‌سازی'
      }
    }
    c2 = askStep 'فروش به مشتریان اول' {
      #unknownSkill
      icon https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/icons/unlock.svg
      technology 'skill: —'
      description 'out: ۳ مشتری پرداخت‌کننده'
      metadata {
        agent 'ایجنت تجاری‌سازی'
      }
    }
    c1 -> c2 'بعد'
  }

  p8 = orgBox 'توسعه، رشد و یادگیری' {
    icon https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/icons/unlock.svg
    description 'out: حلقهٔ همیشگی تا مقیاس یا خروج'
    metadata {
      schedule 'weekly'
      agent 'ایجنت رشد'
    }
    c1 = autoStep 'پایش شاخص‌ها' {
      #unknownSkill
      icon https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/icons/unlock.svg
      technology 'skill: —'
      description 'out: گزارش هفتگی: درآمد، هزینه، رشد، رضایت'
      metadata {
        agent 'ایجنت رشد'
      }
    }
    c2 = autoStep 'آزمایش‌های رشد' {
      #unknownSkill
      icon https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/icons/unlock.svg
      technology 'skill: —'
      description 'out: فهرست آزمایش‌ها با نتیجه و تصمیم'
      metadata {
        agent 'ایجنت رشد'
      }
    }
    c3 = autoStep 'ثبت درس‌ها و به‌روزرسانی معیارها' {
      #unknownSkill
      icon https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/icons/unlock.svg
      technology 'skill: —'
      description 'out: درس‌ها در کتابخانهٔ استودیو برای استارتاپ بعدی'
      metadata {
        agent 'ایجنت رشد'
      }
    }
    c4 = gateStep 'ثبت رویهٔ تکراری' {
      #unknownSkill
      icon https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/icons/unlock.svg
      technology 'skill: —'
      description 'out: کاری که دوباره آمد به‌صورت رویهٔ نوشته‌شده (قدم‌ها، ورودی، خروجی، کجا بپرسد) پیشنهاد می‌شود؛ با تأیید انسان ذخیره می‌شود و بازبینی دوره‌ای دارد'
      metadata {
        agent 'ایجنت رشد'
      }
    }
    c5 = autoStep 'هدف‌ها و شاخص‌های فصلی (OKR)' {
      #unknownSkill
      icon https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/icons/unlock.svg
      technology 'skill: —'
      description 'out: هدف‌های فصل بعد با شاخص قابل اندازه‌گیری'
      metadata {
        agent 'ایجنت رشد'
      }
    }
    c6 = gateStep 'تصمیم مقیاس، فروش یا خروج' {
      #unknownSkill
      icon https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/icons/unlock.svg
      technology 'skill: —'
      description 'out: ادامه، فروش شرکت یا بورس؛ مسیر خروج UNKNOWN تا مشاور؛ فقط انسان تصمیم می‌گیرد'
      metadata {
        agent 'ایجنت رشد'
      }
    }
    c1 -> c2 'بعد'
    c2 -> c3 'بعد'
    c3 -> c4 'بعد'
    c4 -> c5 'بعد'
    c5 -> c6 'بعد'
  }

  p0 -> p1 'بعد'
  p1 -> p2 'بعد'
  p2 -> reg 'بعد'
  reg -> tm 'بعد'
  tm -> legal 'بعد'
  legal -> ip 'بعد'
  ip -> fin 'بعد'
  fin -> p4 'بعد'
  p4 -> train 'بعد'
  train -> sec 'بعد'
  sec -> team 'بعد'
  team -> p5 'بعد'
  p5 -> pitch 'بعد'
  pitch -> p6 'بعد'
  p6 -> web 'بعد'
  web -> ads 'بعد'
  ads -> content 'بعد'
  content -> p7 'بعد'
  p7 -> p8 'بعد'
}

views {
  view index {
    title 'استودیوی استارتاپ‌ساز: ارزیابی، ساخت، حقوقی، سهام، سرمایه‌گذار و فروش'
    include *
  }

  view p0 of p0 {
    title 'ورودی و تشخیص نوع'
    include *
  }

  view p1 of p1 {
    title 'ارزیابی و اعتبارسنجی'
    include *
  }

  view p2 of p2 {
    title 'نام‌گذاری، برند و دارایی‌های دیجیتال'
    include *
  }

  view reg of reg {
    title 'ثبت شرکت'
    include *
  }

  view tm of tm {
    title 'نام و علامت تجاری (برند)'
    include *
  }

  view legal of legal {
    title 'کارهای حقوقی'
    include *
  }

  view ip of ip {
    title 'دانش‌بنیان و ثبت اختراع'
    include *
  }

  view fin of fin {
    title 'مالی، مالیات و حسابداری'
    include *
  }

  view p4 of p4 {
    title 'ساخت و راه‌اندازی MVP'
    include *
  }

  view train of train {
    title 'آموزش پرسنل و تیم'
    include *
  }

  view sec of sec {
    title 'امنیت و حریم خصوصی'
    include *
  }

  view team of team {
    title 'استخدام و حاکمیت شرکت'
    include *
  }

  view p5 of p5 {
    title 'ارزش‌گذاری و ساختار سهام'
    include *
  }

  view pitch of pitch {
    title 'ارائه به سرمایه‌گذار'
    include *
  }

  view p6 of p6 {
    title 'سرمایه‌گذار، هم‌بنیان‌گذار و شریک'
    include *
  }

  view web of web {
    title 'سایت و صفحهٔ فرود'
    include *
  }

  view ads of ads {
    title 'تبلیغات'
    include *
  }

  view content of content {
    title 'محتوا و انتشار'
    include *
  }

  view p7 of p7 {
    title 'تجاری‌سازی و فروش'
    include *
  }

  view p8 of p8 {
    title 'توسعه، رشد و یادگیری'
    include *
  }
}