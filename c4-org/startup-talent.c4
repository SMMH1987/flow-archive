    c2 = autoStep 'قیمت‌گذاری و بستهٔ جذب مشتری' {
      icon https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/icons/unlock.svg
      technology 'skill: pricing-advisor'
      description 'out: جدول قیمت + نردبان جذب مشتری'
      metadata {
        agent 'ایجنت تجاری‌سازی'
      }
    }
    c3 = autoStep 'ساخت صفحهٔ فرود و محتوا' {
      #unknownSkill
      icon https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/icons/unlock.svg
      technology 'skill: —'
      description 'out: صفحهٔ فرود + ۱۰ محتوای معرفی'
      metadata {
        agent 'ایجنت تجاری‌سازی'
      }
    }
    c4 = gateStep 'تأیید و انتشار کمپین' {
      #unknownSkill
      icon https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/icons/unlock.svg
      technology 'skill: —'
      description 'out: انتشار بیرونی فقط با تأیید انسان'
      metadata {
        agent 'ایجنت تجاری‌سازی'
      }
    }
    c5 = askStep 'فروش به ۳ مشتری اول' {
      #unknownSkill
      icon https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/icons/unlock.svg
      technology 'skill: —'
      description 'out: ۳ قرارداد یا پیش‌پرداخت'
      metadata {
        agent 'ایجنت تجاری‌سازی'
      }
    }
    c1 -> c2 'بعد'
    c2 -> c3 'بعد'
    c3 -> c4 'بعد'
    c4 -> c5 'بعد'
  }

  p8 = orgBox 'رشد، پشتیبانی و بهبود' {
    icon https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/icons/unlock.svg
    description 'out: حلقهٔ همیشگی بعد از شروع فروش'
    metadata {
      schedule 'weekly'
      agent 'ایجنت بهبود'
    }
    c1 = autoStep 'پایش شاخص‌ها' {
      #unknownSkill
      icon https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/icons/unlock.svg
      technology 'skill: —'
      description 'out: گزارش هفتگی: کاربر فعال، هزینه، رضایت'
      metadata {
        agent 'ایجنت بهبود'
      }
    }
    c2 = askStep 'پشتیبانی و رسیدگی به درخواست‌ها' {
      #unknownSkill
      icon https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/icons/unlock.svg
      technology 'skill: —'
      description 'out: پاسخ‌ها و درخواست‌های حذف داده'
      metadata {
        agent 'ایجنت بهبود'
      }
    }
    c3 = autoStep 'به‌روزرسانی پرسشنامه‌ها و شایستگی‌ها' {
      #unknownSkill
      icon https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/icons/unlock.svg
      technology 'skill: —'
      description 'out: فهرست تغییرهای پیشنهادی؛ اعمال با تأیید'
      metadata {
        ext_tool 'Firecrawl MCP'
        ext_kind 'MCP'
        agent 'ایجنت بهبود'
      }
    }
    c4 = gateStep 'تصمیم مقیاس‌دهی' {
      #unknownSkill
      icon https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/icons/unlock.svg
