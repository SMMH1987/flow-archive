  p0 -> p1 'بعد'
  p1 -> p2 'بعد'
  p2 -> p3 'بعد'
  p3 -> p4 'بعد'
  p4 -> p5 'بعد'
  p5 -> p6 'بعد'
  p6 -> p7 'بعد'
  p7 -> p8 'بعد'
}

views {
  view index {
    title 'استارتاپ ایجنت هوشمند استعدادیابی، غربال، رزومه و استخدام'
    include *
  }

  view p0 of p0 {
    title 'پیش‌نیازهای شروع'
    include *
  }

  view p1 of p1 {
    title 'ایده و اعتبارسنجی'
    include *
  }

  view p2 of p2 {
    title 'نام‌گذاری و برند'
    include *
  }

  view p3 of p3 {
    title 'طراحی فرایند محصول'
    include *
  }

  view p4 of p4 {
    title 'حقوقی، حریم خصوصی و انطباق'
    include *
  }

  view p5 of p5 {
    title 'ساخت MVP'
    include *
  }

  view p6 of p6 {
    title 'آزمایش با کاربران واقعی'
    include *
  }

  view p7 of p7 {
    title 'قیمت‌گذاری و تجاری‌سازی'
    include *
  }

  view p8 of p8 {
    title 'رشد، پشتیبانی و بهبود'
    include *
  }
}