    role["شرح شغل و مدل پورسانت<br>skill: first-principles<br>out: وظایف + درصد پورسانت + سقف + دورهٔ پرداخت<br>after: ask"]
  end
  subgraph s2["2 · جذب"]
    ad["آگهی استخدام<br>skill: marketing-skills:copywriting<br>out: متن آگهی + ۳ تیتر<br>after: auto"]
    post["انتشار آگهی<br>skill: marketing-skills:social<br>out: پیش‌نویس پست در ۲ کانال، بدون انتشار خودکار<br>after: gate"]
  end
  subgraph s3["3 · غربال"]
    screen["غربال رزومه‌ها<br>skill: —<br>out: امتیاز ۰ تا ۱۰ برای هر نفر + دلیل<br>after: auto"]
