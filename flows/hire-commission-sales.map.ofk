%% ofk 1
architecture
title: "Map: استخدام نیروی فروش درصدی (2026-10-29)"
// همان فلوی hire-commission-sales.ofk، به شکل مدل معماری تا تب Map اوپن‌فلوکیت بتواند بخوانَدش.
// بخش = container (جعبهٔ بازشونده) · قدم = component · tech: = skill · برچسب فلش = نتیجه/شاخه
// برای اجرا، cc-flow-run همچنان hire-commission-sales.ofk را می‌خواند؛ این فایل فقط برای دیدن است.
model {
 person "کارفرما" [desc: "هدف می‌دهد، در دروازه‌ها تأیید می‌کند"]
 person "کاندیدا" [desc: "رزومه می‌فرستد، مصاحبه می‌دهد"]
 system "استخدام فروشندهٔ درصدی" [desc: "۶ بخش، هر قدم با skill خودش"] {
  container "1 · تعریف نقش" {
   component "هدف" [tech: "—", desc: "محصول + بازار + تعداد نفر"]
   component "شرح شغل و پورسانت" [tech: "first-principles", desc: "درصد + سقف + دورهٔ پرداخت"]
  }
  container "2 · جذب" {
   component "آگهی استخدام" [tech: "copywriting", desc: "متن + ۳ تیتر"]
   component "انتشار آگهی" [tech: "social", desc: "پیش‌نویس، بدون انتشار خودکار"]
  }
  container "3 · غربال" {
   component "غربال رزومه‌ها" [tech: "—", desc: "امتیاز ۰ تا ۱۰"]
   component "پیام رد" [tech: "copywriting", desc: "پیش‌نویس، بدون ارسال خودکار"]
  }
  container "4 · مصاحبه" {
   component "سؤال‌های مصاحبه" [tech: "grilling", desc: "۱۰ سؤال + نقش‌آفرینی فروش"]
   component "مصاحبه و نمره" [tech: "—", desc: "نمره از کارفرما"]
  }
  container "5 · قرارداد" [tags: locked] {
   component "قرارداد درصدی" [tech: "docx", desc: "قرارداد.docx"]
  }
  container "6 · شروع کار" {
   component "کیت فروش" [tech: "sales-enablement", desc: "اسکریپت + پاسخ به اعتراض"]
   component "هدف ۳۰ روز" [tech: "—", desc: "فروش + نرخ تبدیل"]
  }
  "هدف" -> "شرح شغل و پورسانت" : بعد
  "شرح شغل و پورسانت" -> "آگهی استخدام" : بعد
  "آگهی استخدام" -> "انتشار آگهی" : بعد
  "انتشار آگهی" -> "غربال رزومه‌ها" : تأیید شد
  "غربال رزومه‌ها" -> "سؤال‌های مصاحبه" : امتیاز ۷+
  "غربال رزومه‌ها" -> "آگهی استخدام" : هیچ‌کس
  "سؤال‌های مصاحبه" -> "مصاحبه و نمره" : بعد
  "مصاحبه و نمره" -> "قرارداد درصدی" : قبول
  "مصاحبه و نمره" -> "پیام رد" : رد
  "پیام رد" -> "غربال رزومه‌ها" : نفر بعدی
  "قرارداد درصدی" -> "کیت فروش" : پذیرفت
  "قرارداد درصدی" -> "غربال رزومه‌ها" : نپذیرفت
  "کیت فروش" -> "هدف ۳۰ روز" : بعد
 }
 "کارفرما" -> "هدف" : هدف و تأییدها
 "کاندیدا" -> "غربال رزومه‌ها" : رزومه
 "کاندیدا" -> "مصاحبه و نمره" : مصاحبه
}
views {
 view landscape
 view container of "استخدام فروشندهٔ درصدی"
}
